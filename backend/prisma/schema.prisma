// =============================================================================
// Systeme de leasing imprimantes / cartouches / compteurs
// Schema derive du classeur Excel "Gestion cartouche et imprimante.xlsx"
// PostgreSQL + Prisma — source de verite avant les API NestJS
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS (listes Parametres / Listes Techniques / statuts calcules Excel)
// -----------------------------------------------------------------------------

enum StatutImprimante {
  FONCTIONNELLE
  EN_MAINTENANCE
  HORS_SERVICE
  RETIREE
}

enum CouleurToner {
  TONER_BLACK
  TONER_CYAN
  TONER_MAGENTA
  TONER_YELLOW
}

enum StatutStock {
  EN_STOCK
  PARTIELLEMENT_UTILISEE
  EPUISE
  SUR_AFFECTE
  AUCUN_STOCK
}

enum MotifAffectation {
  REMPLACEMENT_NORMAL
  TONER_VIDE
  PANNE_IMPRESSION
  TEST
  URGENCE
  MAINTENANCE
}

enum StatutPose {
  OK
  A_REPRENDRE
  ECHEC
  EN_ATTENTE
}

enum TypeMaintenance {
  PREVENTIVE
  CORRECTIVE
  DEPANNAGE
  NETTOYAGE
  REMPLACEMENT_PIECE
  CONTROLE_PERIODIQUE
  ASSISTANCE
}

enum StatutReleve {
  BASE_INITIALE
  BROUILLON
  SAISI
  OK
  ANOMALIE_COMPTEUR
  A_CONTROLER
  CONTROLE
  VALIDE
  DOUBLON_PERIODE
}

enum ObservationReleve {
  RAS
  RESET_COMPTEUR
  MACHINE_REMPLACEE
  RELEVE_ESTIME
  CONTROLE_TECHNIQUE
  AUTRE
}

enum StatutLigneSaisie {
  A_SAISIR
  BROUILLON
  PRET
  ANOMALIE
  DOUBLON_POSSIBLE
}

enum StatutFactureLigne {
  A_FACTURER
  AUCUNE_FACTURE
  FACTUREE
  ANNULEE
}

enum StatutFacturePeriode {
  BROUILLON
  CALCULEE
  CLOTUREE
  ANNULEE
}

enum TypeTarif {
  COPIE_NB
  COPIE_COULEUR
  SCAN_NOIR
  SCAN_COULEUR
  ENVOI
}

enum EntiteSequence {
  IMPRIMANTE
  ENTREE_STOCK
  AFFECTATION
  RELEVE
  MAINTENANCE
  FACTURE
}

enum RoleUtilisateur {
  ADMIN
  TECHNICIEN
  FACTURATION
  LECTURE
}

// -----------------------------------------------------------------------------
// REFERENTIELS
// -----------------------------------------------------------------------------

model Marque {
  id        String   @id @default(cuid())
  nom       String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imprimantes      Imprimante[]
  modelesCartouche ModeleCartouche[]
}

model Fournisseur {
  id        String   @id @default(cuid())
  nom       String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imprimantes  Imprimante[]
  entreesStock EntreeStock[]
}

model Agent {
  id        String   @id @default(cuid())
  nom       String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affectations Affectation[]
  maintenances Maintenance[]
}

model Service {
  id        String   @id @default(cuid())
  nom       String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imprimantes Imprimante[]
}

model Client {
  id         String   @id @default(cuid())
  nom        String   @unique
  telephone  String?
  email      String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockProduits StockProduit[]
}

model TarifLeasing {
  id           String    @id @default(cuid())
  type         TypeTarif @unique
  libelle      String
  prixUnitaire Decimal   @db.Decimal(12, 2)
  devise       String    @default("XOF")
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model IdSequenceConfig {
  id            String         @id @default(cuid())
  entite        EntiteSequence @unique
  prefixe       String
  formatNum     String         @default("0000")
  dernierNumero Int            @default(0)
  declenchement String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Utilisateur {
  id                 String          @id @default(cuid())
  email              String          @unique
  nom                String
  prenom             String?
  nomFamille         String?
  autreAdresse       String?
  telephone          String?
  autreTelephone     String?
  dateNaissance      DateTime?       @db.Date
  avatarUrl          String?
  languePref         String          @default("fr")
  notifEmail         Boolean         @default(true)
  motDePasseHash     String
  role               RoleUtilisateur @default(TECHNICIEN)
  /// Rôle métier configurable (CRUD) — source des permissions si présent
  roleMetierId       String?
  roleMetier         RoleMetier?     @relation(fields: [roleMetierId], references: [id], onDelete: SetNull)
  /// Permissions modules (vide = défauts du rôle). ADMIN ignore cette liste.
  permissions        String[]        @default([])
  /// Obligatoire au premier login / après reset
  mustChangePassword Boolean         @default(true)
  actif              Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  auditLogs             AuditLog[]
  notifications         Notification[]
  messagesEnvoyes       MessageInterne[] @relation("MessagesEnvoyes")
  messagesRecus         MessageInterne[] @relation("MessagesRecus")
  assistancesAssignees  Maintenance[]    @relation("AssistanceAssignee")
  backupsRequested      Backup[]         @relation("BackupRequestedBy")

  @@index([roleMetierId])
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BackupType {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
}

/// Historique / supervision des sauvegardes PostgreSQL (systemd + rclone)
model Backup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(RUNNING)
  type          BackupType
  startedAt     DateTime
  completedAt   DateTime?
  filename      String?
  size          BigInt?
  destination   String?
  errorMessage  String?
  /// Identifiant unique du fichier résultat script (anti double-ingest)
  resultKey     String?      @unique
  requestedById String?
  requestedBy   Utilisateur? @relation("BackupRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([type])
  @@index([startedAt])
  @@index([requestedById])
}

/// Rôles métier configurables (CRUD) avec permissions modules
model RoleMetier {
  id          String        @id @default(cuid())
  code        String        @unique
  libelle     String
  description String?
  permissions String[]      @default([])
  /// Rôles système (ADMIN, TECHNICIEN…) non supprimables
  systeme     Boolean       @default(false)
  actif       Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  utilisateurs Utilisateur[]
}

// -----------------------------------------------------------------------------
// PARC IMPRIMANTES
// -----------------------------------------------------------------------------

model Imprimante {
  id                   String           @id @default(cuid())
  code                 String           @unique // IMP-0001
  marqueId             String?
  marque               Marque?          @relation(fields: [marqueId], references: [id])
  modele               String
  numeroSerie          String           @unique
  localisation         String?
  statut               StatutImprimante @default(FONCTIONNELLE)
  fournisseurId        String?
  fournisseur          Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  serviceId            String?
  service              Service?         @relation(fields: [serviceId], references: [id])
  dateInstallation     DateTime?        @db.Date
  prochaineMaintenance DateTime?        @db.Date
  observations         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  affectations  Affectation[]
  releves       ReleveCompteur[]
  maintenances  Maintenance[]
  lignesSaisie  LigneSaisieMensuelle[]
  lignesFacture FactureLigne[]

  @@index([statut])
  @@index([localisation])
}

// -----------------------------------------------------------------------------
// STOCK CARTOUCHES (modele + couleur + quantites)
// -----------------------------------------------------------------------------

model ModeleCartouche {
  id           String   @id @default(cuid())
  modele       String // C-EXV 64
  marqueId     String?
  marque       Marque?  @relation(fields: [marqueId], references: [id])
  refFabricant String?
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skus         CartoucheSku[]
  entrees      EntreeStock[]
  affectations Affectation[]

  @@unique([modele, marqueId])
}

/// Stock agrege par (modele, couleur) — solde tenu a jour par le service metier
model CartoucheSku {
  id          String          @id @default(cuid())
  modeleId    String
  modele      ModeleCartouche @relation(fields: [modeleId], references: [id])
  couleur     CouleurToner
  qteEntrees  Int             @default(0)
  qteSorties  Int             @default(0)
  qteRestante Int             @default(0)
  statut      StatutStock     @default(AUCUN_STOCK)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lignesAffectation AffectationLigne[]
  lignesEntree      EntreeStock[]

  @@unique([modeleId, couleur])
}

model EntreeStock {
  id            String          @id @default(cuid())
  code          String          @unique // ENT-0001
  dateEntree    DateTime        @db.Date
  heureEntree   DateTime? // heure seule stockee en DateTime
  modeleId      String
  modele        ModeleCartouche @relation(fields: [modeleId], references: [id])
  skuId         String?
  sku           CartoucheSku?   @relation(fields: [skuId], references: [id])
  couleur       CouleurToner
  qte           Int
  fournisseurId String?
  fournisseur   Fournisseur?    @relation(fields: [fournisseurId], references: [id])
  observations  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([dateEntree])
  @@index([couleur])
}

// -----------------------------------------------------------------------------
// AFFECTATIONS / POSES (kit complet ou partiel CMYK)
// -----------------------------------------------------------------------------

model Affectation {
  id           String            @id @default(cuid())
  code         String            @unique // AFF-0001
  datePose     DateTime          @db.Date
  heurePose    DateTime?
  imprimanteId String
  imprimante   Imprimante        @relation(fields: [imprimanteId], references: [id])
  modeleId     String
  modele       ModeleCartouche   @relation(fields: [modeleId], references: [id])
  agentId      String?
  agent        Agent?            @relation(fields: [agentId], references: [id])
  motif        MotifAffectation?
  statutPose   StatutPose        @default(OK)
  observations String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lignes AffectationLigne[]

  @@index([datePose])
  @@index([imprimanteId])
}

model AffectationLigne {
  id            String        @id @default(cuid())
  affectationId String
  affectation   Affectation   @relation(fields: [affectationId], references: [id], onDelete: Cascade)
  skuId         String?
  sku           CartoucheSku? @relation(fields: [skuId], references: [id])
  couleur       CouleurToner
  qte           Int

  @@unique([affectationId, couleur])
}

// -----------------------------------------------------------------------------
// RELEVES COMPTEURS (coeur leasing Canon 112/113/122/123)
// -----------------------------------------------------------------------------

model ReleveCompteur {
  id           String     @id @default(cuid())
  code         String     @unique // REL-0001
  imprimanteId String
  imprimante   Imprimante @relation(fields: [imprimanteId], references: [id])
  moisFacture  String // YYYY-MM
  dateReleve   DateTime   @db.Date
  heureReleve  DateTime?

  // Compteurs papier (saisie)
  c112 Int @default(0) // Noir grand format
  c113 Int @default(0) // Noir petit format
  c122 Int @default(0) // Couleur grand format
  c123 Int @default(0) // Couleur petit format

  // Controles rapport
  c501 Int? // Total lecture
  c301 Int? // Total impression (controle noir)

  // Scans / envois
  scanNoir    Int @default(0)
  scanCouleur Int @default(0)
  envoi       Int @default(0)

  // Snapshot calculé au moment de la validation (audit / facturation)
  totalNoir             Int                @default(0) // 112+113
  totalCouleur          Int                @default(0) // 122+123
  ancienTotalNoir       Int?
  ancienTotalCouleur    Int?
  copiesNoirBrutes      Int                @default(0) // peut être négatif
  copiesCouleurBrutes   Int                @default(0)
  scansNoirBruts        Int                @default(0)
  scansCouleurBruts     Int                @default(0)
  envoisBruts           Int                @default(0)
  /// Consommation du mois avant application du quota
  copiesNoirDelta       Int                @default(0)
  copiesCouleurDelta    Int                @default(0)
  /// Quota disponible ce mois (base + report précédent)
  quotaNoirDispo        Int                @default(1000)
  quotaCouleurDispo     Int                @default(2000)
  /// Part couverte par le quota (non facturée)
  copiesNoirIncluses    Int                @default(0)
  copiesCouleurIncluses Int                @default(0)
  /// Reliquat reporté au mois suivant
  quotaNoirReport       Int                @default(0)
  quotaCouleurReport    Int                @default(0)
  /// Copies facturables après quota
  copiesNoirFacturer    Int                @default(0)
  copiesCouleurFacturer Int                @default(0)
  totalCopiesFacturer   Int                @default(0)
  ancienScanNoir        Int?
  ancienScanCouleur     Int?
  ancienEnvoi           Int?
  scansNoirFacturer     Int                @default(0)
  scansCouleurFacturer  Int                @default(0)
  envoisFacturer        Int                @default(0)
  ecartControle         Int? // 301 - totalNoir
  alerteDeltaHaut       Boolean            @default(false)
  alerteEcart301        Boolean            @default(false)
  statut                StatutReleve       @default(BASE_INITIALE)
  observationMotif      ObservationReleve?
  observations          String?
  controleAt            DateTime?
  controleParId         String?
  valideAt              DateTime?
  valideParId           String?

  /// Rapport de compteur prélevé (PDF / image)
  rapportPath String?
  rapportNom  String?
  rapportMime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits     ReleveAudit[]
  assistance Maintenance?

  @@unique([imprimanteId, moisFacture]) // un relevé facturable / mois (ajustable si besoin multi)
  @@index([moisFacture])
  @@index([dateReleve])
  @@index([statut])
}

model ReleveAudit {
  id        String         @id @default(cuid())
  releveId  String
  releve    ReleveCompteur @relation(fields: [releveId], references: [id], onDelete: Cascade)
  userId    String?
  action    String // CREATE | UPDATE | ACCEPT_ANOMALY | CONTROL | VALIDATE | IMPORT
  beforeJson String?
  afterJson  String?
  createdAt DateTime       @default(now())

  @@index([releveId, createdAt])
}

// -----------------------------------------------------------------------------
// CAMPAGNE SAISIE MENSUELLE (brouillon avant archivage)
// -----------------------------------------------------------------------------

model CampagneSaisie {
  id          String   @id @default(cuid())
  mois        String   @unique // YYYY-MM
  dateReleve  DateTime @db.Date
  heureReleve String?  @default("09:00")
  cloturee    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lignes LigneSaisieMensuelle[]
}

model LigneSaisieMensuelle {
  id           String         @id @default(cuid())
  campagneId   String
  campagne     CampagneSaisie @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  imprimanteId String
  imprimante   Imprimante     @relation(fields: [imprimanteId], references: [id])

  c112        Int?
  c113        Int?
  c122        Int?
  c123        Int?
  c501        Int?
  c301        Int?
  scanNoir    Int?
  scanCouleur Int?
  envoi       Int?

  statutLigne         StatutLigneSaisie @default(A_SAISIR)
  observationMotif    ObservationReleve?
  observations        String?
  archiveVersReleveId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campagneId, imprimanteId])
}

// -----------------------------------------------------------------------------
// MAINTENANCE
// -----------------------------------------------------------------------------

model Maintenance {
  id                   String          @id @default(cuid())
  code                 String          @unique // MNT-0001
  dateMaintenance      DateTime        @db.Date
  heureMaintenance     DateTime?
  imprimanteId         String
  imprimante           Imprimante      @relation(fields: [imprimanteId], references: [id])
  type                 TypeMaintenance
  technicienId         String?
  technicien           Agent?          @relation(fields: [technicienId], references: [id])
  /// Utilisateur chargé de l'assistance (reçoit la notif)
  assigneeUserId       String?
  assigneeUser         Utilisateur?    @relation("AssistanceAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  actionsRealisees     String?
  piecesConsommables   String?
  prochaineMaintenance DateTime?       @db.Date
  observations         String?
  /// Mois civil de l'assistance (YYYY-MM) — quota 3 / imprimante / mois
  moisAssistance       String?
  /// Lien optionnel vers le relevé qui a généré l'assistance
  releveId             String?         @unique
  releve               ReleveCompteur? @relation(fields: [releveId], references: [id], onDelete: SetNull)
  /// Rapport d'assistance (PDF / image)
  rapportPath          String?
  rapportNom           String?
  rapportMime          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([imprimanteId])
  @@index([dateMaintenance])
  @@index([moisAssistance])
  @@index([type, moisAssistance])
  @@index([assigneeUserId])
}

// -----------------------------------------------------------------------------
// FACTURATION (snapshot periode — historique comptable)
// -----------------------------------------------------------------------------

model FacturePeriode {
  id              String               @id @default(cuid())
  code            String               @unique // FAC-2026-07
  mois            String               @unique // YYYY-MM
  debutPeriode    DateTime             @db.Date
  finPeriode      DateTime             @db.Date
  prixNb          Decimal              @db.Decimal(12, 2)
  prixCouleur     Decimal              @db.Decimal(12, 2)
  prixScanNoir    Decimal              @db.Decimal(12, 2)
  prixScanCouleur Decimal              @db.Decimal(12, 2)
  prixEnvoi       Decimal              @db.Decimal(12, 2)
  montantTotal    Decimal              @default(0) @db.Decimal(14, 2)
  statut          StatutFacturePeriode @default(BROUILLON)
  clotureeAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  lignes FactureLigne[]
}

model FactureLigne {
  id            String             @id @default(cuid())
  periodeId     String
  periode       FacturePeriode     @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  imprimanteId  String
  imprimante    Imprimante         @relation(fields: [imprimanteId], references: [id])
  nbReleves     Int                @default(0)
  copiesNb      Int                @default(0)
  copiesCouleur Int                @default(0)
  totalCopies   Int                @default(0)
  scansNoir     Int                @default(0)
  scansCouleur  Int                @default(0)
  envois        Int                @default(0)
  montantCopies Decimal            @default(0) @db.Decimal(14, 2)
  montantScans  Decimal            @default(0) @db.Decimal(14, 2)
  montantTotal  Decimal            @default(0) @db.Decimal(14, 2)
  statut        StatutFactureLigne @default(A_FACTURER)

  @@unique([periodeId, imprimanteId])
}

// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------

model AuditLog {
  id         String       @id @default(cuid())
  dateHeure  DateTime     @default(now())
  userId     String?
  user       Utilisateur? @relation(fields: [userId], references: [id])
  action     String
  entite     String?
  entiteId   String?
  details    String?
  ipAdresse  String?
  userAgent  String?
  resultat   String       @default("SUCCESS")

  @@index([dateHeure])
  @@index([userId])
  @@index([entite])
  @@index([action])
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS & MESSAGERIE
// -----------------------------------------------------------------------------

enum NotificationType {
  STOCK_BAS
  STOCK_EPUISE
  ANOMALIE_RELEVE
  MAINTENANCE_PROCHE
  ASSISTANCE_QUOTA
  FACTURATION
  CAMPAGNE
  SYSTEME
  MESSAGE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        Utilisateur          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  titre       String
  message     String
  lien        String?
  fingerprint String
  luAt        DateTime?
  createdAt   DateTime             @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, createdAt])
  @@index([userId, luAt])
}

model MessageInterne {
  id             String      @id @default(cuid())
  expediteurId   String
  expediteur     Utilisateur @relation("MessagesEnvoyes", fields: [expediteurId], references: [id], onDelete: Cascade)
  destinataireId String
  destinataire   Utilisateur @relation("MessagesRecus", fields: [destinataireId], references: [id], onDelete: Cascade)
  sujet          String
  corps          String
  luAt           DateTime?
  createdAt      DateTime    @default(now())

  @@index([destinataireId, createdAt])
  @@index([expediteurId, createdAt])
  @@index([destinataireId, luAt])
}

// -----------------------------------------------------------------------------
// STOCK PRODUITS (hors leasing copieurs) — suivi réceptions / livraisons
// -----------------------------------------------------------------------------

enum StatutStockProduit {
  RECEPTION_EN_ATTENTE
  EN_STOCK
  PARTIELLEMENT_LIVRE
  LIVRE
  ANNULE
}

/// Une ligne = une réception de produit (puis livraisons cumulées sur la même ligne)
model StockProduit {
  id            String             @id @default(cuid())
  numero        Int                @unique
  designation   String
  reference     String?
  fournisseur   String?
  qteRecue      Int                @default(0)
  dateReception DateTime?          @db.Date
  bonReception  String?
  qteLivree     Int                @default(0)
  dateLivraison DateTime?          @db.Date
  destinataire  String?
  clientId      String?
  client        Client?            @relation(fields: [clientId], references: [id])
  bonLivraison  String?
  statut        StatutStockProduit @default(RECEPTION_EN_ATTENTE)
  /// Si true, le statut n’est plus recalculé automatiquement
  statutManuel  Boolean            @default(false)
  observations  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([statut])
  @@index([dateReception])
  @@index([destinataire])
  @@index([clientId])
  @@index([fournisseur])
  @@index([designation])
}
