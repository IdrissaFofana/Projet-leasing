# Environment Prisma / NestJS
DATABASE_URL="postgresql://postgres:root@localhost:5432/leasing_imprimantes?schema=public"
PORT=3001
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Sauvegardes — supervision (systemd + script existants). En local : MOCK=true
BACKUP_MOCK=true
BACKUP_RESULTS_DIR=./.tmp/leasing-backup/results
BACKUP_PENDING_FILE=./.tmp/leasing-backup/pending.json
BACKUP_INGEST_MS=15000

# Rapports PDF (Ubuntu prod) — chemin vers Chromium/Chrome système
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# CHROME_PATH=/usr/bin/google-chrome-stable
